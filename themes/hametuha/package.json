{
  "name": "hametuha",
  "homepage": "https://hametuha.com",
  "description": "A WordPress Theme for Hametuha.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hametuha/hametuha.git"
  },
  "scripts": {
    "package": "npm run clean && npm run copy-libs && npm run build:css && npm run build:blocks && npm run build:js",
    "clean": "rm -rf assets/js assets/css assets/blocks assets/vendor",
    "copy-libs": "node bin/copy-libs.js",
    "build:css": "sass ./assets-src/scss/:./assets/css/ --style=compressed --no-source-map --quiet-deps --load-path=node_modules --load-path=vendor --load-path=vendor/hametuha && postcss ./assets/css/**/*.css --use autoprefixer --replace --no-map",
    "build:js": "grab-deps js assets-src/js assets/js && npm run dump",
    "dump": "grab-deps dump assets/js,assets/css",
    "watch": "npm-watch",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "wp-scripts lint-js \"./assets-src/**/*.js\"",
    "lint:css": "wp-scripts lint-style \"./assets-src/**/*.scss\"",
    "fix": "npm run fix:js && npm run fix:css",
    "fix:js": "wp-scripts lint-js --fix \"./assets-src/**/*.js\"",
    "fix:css": "wp-scripts lint-style --fix \"./assets-src/**/*.scss\"",
    "compress-images": "node bin/compress-images.js",
    "build:blocks": "wp-scripts build --webpack-src-dir=assets-src/blocks --output-path=assets/blocks"
  },
  "author": "Hametuha inc.",
  "license": "LGPL-3.0-or-later",
  "devDependencies": {
    "@kunoichi/grab-deps": "^3.3.0",
    "@wordpress/scripts": "^37.1.0",
    "autoprefixer": "^10.6.2",
    "bootbox": "^6.0.0",
    "bootstrap": "^5.3.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-watch": "^0.13.0",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "sass": "^1.105.2",
    "select2": "^4.1.0",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22"
  },
  "watch": {
    "build:css": {
      "patterns": [
        "assets-src/scss"
      ],
      "extensions": "scss"
    },
    "build:blocks": {
      "patterns": [
        "assets-src/blocks"
      ],
      "extensions": "js,json,scss"
    },
    "build:js": {
      "patterns": [
        "assets-src/js"
      ],
      "extensions": "js"
    }
  },
  "grabDeps": {
    "namespace": "hametuha",
    "js": {
      "srcDir": "assets-src/js",
      "dumpDir": "assets/js",
      "autoHandleGeneration": true
    },
    "css": {
      "srcDir": "assets-src/scss",
      "dumpDir": "assets/css",
      "autoHandleGeneration": true
    }
  }
}
