{
  "name": "hametuha",
  "homepage": "https://hametuha.com",
  "description": "A WordPress Theme for Hametuha.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hametuha/hametuha.git"
  },
  "scripts": {
    "package": "npm run clean && npm run copy-libs && npm run build:css && npm run build:js",
    "clean": "rm -rf dist",
    "copy-libs": "node bin/copy-libs.js",
    "build:css": "sass ./assets/scss/:./dist/css/ --style=compressed --no-source-map --quiet-deps --load-path=node_modules --load-path=vendor --load-path=vendor/hametuha && postcss ./dist/css/**/*.css --use autoprefixer --replace --no-map",
    "build:js": "grab-deps js assets/js dist/js && npm run dump",
    "dump": "grab-deps dump dist/js,dist/css",
    "watch": "npm-watch",
    "compress-images": "node bin/compress-images.js"
  },
  "author": "Hametuha inc.",
  "license": "LGPL-3.0-or-later",
  "devDependencies": {
    "@kunoichi/grab-deps": "^3.3.0",
    "@wordpress/scripts": "^37.1.0",
    "autoprefixer": "^10.6.2",
    "bootbox": "^6.0.0",
    "bootstrap": "^5.3.8",
    "npm-watch": "^0.13.0",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "sass": "^1.105.2",
    "select2": "^4.1.0",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22"
  },
  "watch": {
    "build:css": {
      "patterns": [
        "assets/scss"
      ],
      "extensions": "scss"
    },
    "build:js": {
      "patterns": [
        "assets/js"
      ],
      "extensions": "js"
    }
  },
  "grabDeps": {
    "namespace": "hametuha",
    "js": {
      "srcDir": "assets/js",
      "dumpDir": "dist/js",
      "autoHandleGeneration": true
    },
    "css": {
      "srcDir": "assets/scss",
      "dumpDir": "dist/css",
      "autoHandleGeneration": true
    }
  }
}
